# Python virtual environment & cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.pytest_cache/

# Local cache and temporary runtime data
data/cache/*
!data/cache/.gitkeep
data/state/*
!data/state/.gitkeep
data/logs/*
!data/logs/.gitkeep
*.db
*.sqlite
*.sqlite3

# Sensitive Credentials and Secrets (Strictly Excluded)
credentials/
*service_account*.json
*credential*.json
*credentials*.json
.env
.env.*
.env.local
!.env.example

# Runtime Logs
*.log
