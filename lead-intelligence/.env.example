# ==============================================================================
# Ariyx Lead Intelligence System - Google Sheets Integration Configuration
# ==============================================================================
# SECURITY NOTICE:
# DO NOT store real credentials inside this repository.
# Store the Google Cloud Service Account JSON key in a secure, OS-protected
# directory outside the Git workspace (e.g., %USERPROFILE%\.ariyx\credentials\ on Windows).
# ==============================================================================

# Path to the Google Cloud Service Account JSON Key (Outside Git Repo)
GOOGLE_SHEETS_CREDENTIALS_PATH=%USERPROFILE%\.ariyx\credentials\google_service_account.json

# Target Google Spreadsheet ID
# Found in the Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Target Worksheet / Tab Name (Dedicated to outbound lead intelligence)
WORKSHEET_NAME=Outbound Leads Intelligence

# Optional Free Public Registry Key (UK Companies House - free developer key)
# UK_COMPANIES_HOUSE_API_KEY=

# ==============================================================================
# $0 Budget Free HTTPS Email Verification Waterfall (No Credit Card Required)
# ==============================================================================
# Direct TCP port 25 SMTP verification is blocked by most residential/cloud ISPs.
# To operate at $0 cost over HTTPS (port 443), register free non-card accounts:
#   1. QuickEmailVerification: 100 free credits/day  (requires business domain email signup)
#   2. Verifalia:               25 free credits/day  (Standard quality = 1 credit)
#   3. Reoon Email Verifier:    20 free daily credits + 100 instant signup credits (uses Power Mode)
#   4. ZeroBounce (optional):  100 free credits/month (requires business domain email signup)
# Combined recurring $0 capacity: ~145–148 HTTPS checks/day (~145/day + 100/mo).

# Waterfall execution order (comma-separated)
EMAIL_VERIFIER_WATERFALL=quickemailverification,verifalia,reoon,zerobounce

# QuickEmailVerification Free Tier (100/day, no card)
# QUICKEMAILVERIFICATION_API_KEY=

# Verifalia Free Tier (25/day, no card - API user + password or app key)
# VERIFALIA_USERNAME=
# VERIFALIA_PASSWORD=

# Reoon Free Tier (20/day + 100 signup, no card - strictly runs mode=power)
# REOON_API_KEY=

# ZeroBounce Free Tier (100/month, no card, optional overflow)
# ZEROBOUNCE_API_KEY=

# Optional Self-Hosted Reacher endpoint (only if running on a port-25-open host)
# EMAIL_VERIFIER_PROVIDER=
# EMAIL_VERIFIER_API_URL=
# EMAIL_VERIFIER_API_KEY=
